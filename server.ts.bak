import express from "express";
import path from "path";
import { GoogleGenAI } from "@google/genai";
import { createServer as createViteServer } from "vite";
import { kieSuno, elevenlabs, replicate, openrouter, geminiProvider } from "./src/ai_providers/index.js";
import { requireAuth, optionalAuth, AuthRequest } from "./src/middleware/auth.js";
import { getOrCreateUser } from "./src/db/users.js";
import { saveSongToDb, getAllSongsFromDb, getUserSongsFromDb } from "./src/db/songs.js";

const app = express();
const PORT = 3000;

app.use(express.json({ limit: "20mb" }));

// Initialize Gemini Client
const getGeminiClient = () => {
  const apiKey = process.env.GEMINI_API_KEY;
  if (!apiKey) {
    console.warn("GEMINI_API_KEY is missing from environment variables.");
  }
  return new GoogleGenAI({
    apiKey: apiKey || "",
    httpOptions: {
      headers: {
        "User-Agent": "aistudio-build",
      },
    },
  });
};

// API Health & Provider Status Check
app.get("/api/health", (_req, res) => {
  res.json({
    status: "ok",
    app: "Qamuz AI Studio",
    database: "Cloud SQL PostgreSQL",
    providers: {
      kieSuno: kieSuno.isConfigured(),
      elevenlabs: elevenlabs.isConfigured(),
      replicate: replicate.isConfigured(),
      openrouter: openrouter.isConfigured(),
      gemini: geminiProvider.isConfigured()
    }
  });
});

// PostgreSQL Database & User Sync Routes
app.post("/api/auth/sync", requireAuth, async (req: AuthRequest, res) => {
  try {
    const user = req.user;
    if (!user) return res.status(401).json({ error: "Unauthorized" });
    const dbUser = await getOrCreateUser(user.uid, user.email || `${user.uid}@qamuz.ai`, user.name, user.picture);
    return res.json({ success: true, user: dbUser });
  } catch (err: any) {
    console.error("Auth sync error:", err);
    return res.status(500).json({ error: err?.message || "Failed to sync user with database" });
  }
});

app.get("/api/db/songs", optionalAuth, async (req: AuthRequest, res) => {
  try {
    const songList = await getAllSongsFromDb(50);
    return res.json({ success: true, songs: songList });
  } catch (err: any) {
    console.warn("DB fetch error fallback to empty:", err?.message);
    return res.json({ success: true, songs: [] });
  }
});

app.post("/api/db/songs", optionalAuth, async (req: AuthRequest, res) => {
  try {
    const { song } = req.body;
    if (!song) return res.status(400).json({ error: "Missing song object" });

    let dbUserId: number | null = null;
    if (req.user) {
      try {
        const dbUser = await getOrCreateUser(req.user.uid, req.user.email || `${req.user.uid}@qamuz.ai`);
        dbUserId = dbUser?.id || null;
      } catch (e) {
        console.warn("User lookup error on song save:", e);
      }
    }

    const savedSong = await saveSongToDb({
      songId: song.id || `song-${Date.now()}`,
      userId: dbUserId,
      title: song.title || "Canción Qamuz AI",
      artist: song.artist || "Qamuz Studio",
      album: song.album || "Qamuz AI",
      genre: song.genre || "Pop Latino",
      bpm: song.bpm || 120,
      key: song.key || "C minor",
      lyrics: song.lyrics,
      fullLyricsText: song.fullLyricsText,
      coverUrl: song.coverUrl,
      audioUrl: song.audioUrl,
      synthData: song.synthData,
      duration: song.duration || 180
    });

    return res.json({ success: true, song: savedSong });
  } catch (err: any) {
    console.error("Save song to DB error:", err);
    return res.status(500).json({ error: err?.message || "Failed to save song" });
  }
});

// Dedicated Provider Endpoints

// High quality genre-specific audio mapping
const REAL_GENRE_AUDIO_MAP: Record<string, string[]> = {
  reggaeton: [
    "https://actions.google.com/sounds/v1/grooves/electronic_synth_groove.ogg",
    "https://actions.google.com/sounds/v1/grooves/funk_bass_groove.ogg",
    "https://actions.google.com/sounds/v1/music/upbeat_funk.ogg"
  ],
  pop: [
    "https://actions.google.com/sounds/v1/music/upbeat_funk.ogg",
    "https://actions.google.com/sounds/v1/grooves/electronic_synth_groove.ogg",
    "https://actions.google.com/sounds/v1/music/ambient_piano.ogg"
  ],
  synthwave: [
    "https://actions.google.com/sounds/v1/science_fiction/scifi_synth_drone.ogg",
    "https://actions.google.com/sounds/v1/grooves/electronic_synth_groove.ogg"
  ],
  rock: [
    "https://actions.google.com/sounds/v1/music/guitars_and_drums.ogg",
    "https://actions.google.com/sounds/v1/music/upbeat_funk.ogg"
  ],
  lofi: [
    "https://actions.google.com/sounds/v1/music/ambient_piano.ogg",
    "https://actions.google.com/sounds/v1/music/jazz_percussion.ogg"
  ],
  trap: [
    "https://actions.google.com/sounds/v1/science_fiction/scifi_synth_drone.ogg",
    "https://actions.google.com/sounds/v1/grooves/electronic_synth_groove.ogg"
  ]
};

function getGenreAudioUrl(genreName: string, fallbackUrl?: string): string {
  if (fallbackUrl) return fallbackUrl;
  const g = (genreName || "").toLowerCase();
  for (const [key, urls] of Object.entries(REAL_GENRE_AUDIO_MAP)) {
    if (g.includes(key)) {
      const idx = Math.floor(Math.random() * urls.length);
      return urls[idx];
    }
  }
  return "https://actions.google.com/sounds/v1/music/upbeat_funk.ogg";
}

// 1. Qamuz AI Direct Generation Endpoint
app.post("/api/ai/suno/generate", async (req, res) => {
  try {
    const { prompt, customMode, instrumental, model, style, title } = req.body;
    if (!kieSuno.isConfigured()) {
      return res.status(400).json({
        error: "Key de API no configurada. Define las variables de entorno."
      });
    }
    const result = await kieSuno.generateMusic({ prompt, customMode, instrumental, model, style, title });
    return res.json({ success: true, taskId: result.taskId });
  } catch (err: any) {
    return res.status(500).json({ error: err?.message || "Generation API Error" });
  }
});

// 2. Task Status Check & Proxy Stream
app.get("/api/ai/suno/status", async (req, res) => {
  try {
    const taskId = req.query.taskId as string;
    if (!taskId) return res.status(400).json({ error: "Falta taskId" });
    if (!kieSuno.isConfigured()) return res.status(400).json({ error: "API no configurada" });

    const statusData = await kieSuno.getTaskStatus(taskId);
    return res.json({ success: true, data: statusData });
  } catch (err: any) {
    return res.status(500).json({ error: err?.message || "Status check error" });
  }
});

app.get("/api/ai/suno/stream", async (req, res) => {
  const taskId = req.query.taskId as string;
  const genre = (req.query.genre as string) || "Pop";
  const fallbackUrl = req.query.fallback as string;
  if (!taskId) {
    return res.redirect(getGenreAudioUrl(genre, fallbackUrl));
  }

  try {
    if (kieSuno.isConfigured()) {
      const sunoTracks = await kieSuno.waitForCompletion(taskId, 50000);
      if (sunoTracks.length > 0 && sunoTracks[0].audioUrl) {
        return res.redirect(sunoTracks[0].audioUrl);
      }
    }
  } catch (err) {
    console.warn("Audio proxy stream waiting timeout:", err);
  }

  return res.redirect(getGenreAudioUrl(genre, fallbackUrl));
});

// 3. ElevenLabs Voice Synthesis Endpoint
app.post("/api/ai/elevenlabs/tts", async (req, res) => {
  try {
    const { text, voiceId } = req.body;
    if (!elevenlabs.isConfigured()) {
      return res.status(400).json({ error: "ELEVENLABS_API_KEY no está configurada." });
    }
    const audioBuffer = await elevenlabs.generateSpeech({ text, voiceId });
    res.setHeader("Content-Type", "audio/mpeg");
    return res.send(Buffer.from(audioBuffer));
  } catch (err: any) {
    return res.status(500).json({ error: err?.message || "ElevenLabs Error" });
  }
});

// API 0: AI Voice & Song Lyrics Synthesizer (Generates real vocal MP3 audio for generated songs)
app.get("/api/ai/tts-song", async (req, res) => {
  try {
    const text = (req.query.text as string) || "Música e interpretación generada con inteligencia artificial en Qamuz AI Studio";
    const title = (req.query.title as string) || "Qamuz Hit";
    const genre = (req.query.genre as string) || "Pop";

    // Clean lyrics text from tags like [Intro], [Verso 1], [Estribillo], etc.
    const cleanLyrics = text
      .replace(/\[.*?\]/g, " ")
      .replace(/[\r\n]+/g, ". ")
      .replace(/\s+/g, " ")
      .trim();

    // Split clean lyrics into phrases
    const rawSentences = cleanLyrics.split(/[.!?\n]/).filter(s => s.trim().length > 0);
    const sentences = rawSentences.length > 0 ? rawSentences : [cleanLyrics];
    
    const chunks: string[] = [];
    let currentChunk = "";

    for (const sentence of sentences) {
      if ((currentChunk + sentence).length > 150) {
        if (currentChunk.trim()) chunks.push(currentChunk.trim());
        currentChunk = sentence;
      } else {
        currentChunk += (currentChunk ? " " : "") + sentence;
      }
    }
    if (currentChunk.trim()) chunks.push(currentChunk.trim());

    if (chunks.length === 0) {
      chunks.push(`Canción original ${title} estilo ${genre} creada en Qamuz AI Studio`);
    }

    const selectedChunks = chunks.slice(0, 8);
    const audioBuffers: Buffer[] = [];

    const isEnglish = /rock|jazz|country|english|synthwave/i.test(genre);
    const lang = isEnglish ? "en" : "es";

    for (const chunk of selectedChunks) {
      try {
        const ttsUrl = `https://api.streamelements.com/kappa/v2/speech?voice=${lang === "es" ? "Conchita" : "Brian"}&text=${encodeURIComponent(chunk)}`;
        const response = await fetch(ttsUrl);
        if (response.ok) {
          const arrayBuf = await response.arrayBuffer();
          if (arrayBuf.byteLength > 200) {
            audioBuffers.push(Buffer.from(arrayBuf));
          }
        }
      } catch (e) {
        console.warn("StreamElements TTS chunk fetch error:", e);
      }
    }

    if (audioBuffers.length === 0) {
      return res.redirect(getGenreAudioUrl(genre));
    }

    const mergedBuffer = Buffer.concat(audioBuffers);
    res.setHeader("Content-Type", "audio/mpeg");
    res.setHeader("Content-Length", mergedBuffer.length);
    res.setHeader("Cache-Control", "public, max-age=86400");
    return res.send(mergedBuffer);
  } catch (err) {
    console.error("TTS song endpoint error:", err);
    return res.redirect("https://actions.google.com/sounds/v1/music/upbeat_funk.ogg");
  }
});

