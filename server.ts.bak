// API 1: Generate AI Song (Qamuz Music Engine with Suno & Gemini Fallback)
app.post("/api/ai/generate-song", async (req, res) => {
  try {
    const { prompt, genre = "Pop Latino", mood = "Alegre", vocalStyle = "Voz Femenina", instrumentalOnly = false, title = "", customLyrics = "", engine = "suno-v35" } = req.body;

    const effectivePrompt = (prompt && prompt.trim()) || (customLyrics && customLyrics.trim()) || (title && title.trim()) || `Canción rítmica de ${genre} estilo ${mood} con ${vocalStyle}`;

    // Attempt direct Kie Suno API if Key is present
    if (kieSuno.isConfigured()) {
      try {
        console.log("Kie Suno API is configured. Initiating Suno Generation task...");
        const sunoTask = await kieSuno.generateMusic({
          prompt: customLyrics ? `${effectivePrompt} - ${customLyrics.slice(0, 200)}` : effectivePrompt,
          customMode: true,
          instrumental: instrumentalOnly,
          model: 'V4_5',
          style: `${genre}, ${mood}, ${vocalStyle}`,
          title: title || (effectivePrompt ? effectivePrompt.slice(0, 30) : "Hit Qamuz")
        });

        // Attempt wait for Suno completion (up to 40 seconds for direct finish)
        try {
          const sunoTracks = await kieSuno.waitForCompletion(sunoTask.taskId, 40000);
          if (sunoTracks.length > 0) {
            const track = sunoTracks[0];
            const createdSong = {
              id: `qamuz-${Date.now()}-${Math.random().toString(36).substring(2, 9)}`,
              title: track.title || title || "Canción Qamuz AI",
              artist: "Qamuz AI Engine",
              album: "Qamuz Studio",
              genre: genre,
              bpm: 120,
              key: "C",
              lyrics: [{ time: 0, text: track.prompt }],
              fullLyricsText: customLyrics || track.prompt,
              coverUrl: track.imageUrl,
              audioUrl: track.audioUrl,
              synthData: { tempo: 120 },
              duration: Math.round(track.duration || 180),
              createdAt: new Date().toISOString()
            };
            return res.json({ success: true, song: createdSong, provider: "QamuzEngine" });
          }
        } catch (waitErr) {
          console.warn("Qamuz initial wait response pending, linking stream proxy for background completion");
          const createdSong = {
            id: `qamuz-${Date.now()}-${Math.random().toString(36).substring(2, 9)}`,
            title: title || (effectivePrompt ? effectivePrompt.slice(0, 30) : "Canción Qamuz AI"),
            artist: "Qamuz AI Engine",
            album: "Qamuz Studio",
            genre: genre,
            bpm: 120,
            key: "C",
            lyrics: [{ time: 0, text: effectivePrompt }],
            fullLyricsText: customLyrics || effectivePrompt,
            coverUrl: `https://image.pollinations.ai/prompt/${encodeURIComponent(title || effectivePrompt)}?width=800&height=800&nologo=true`,
            audioUrl: `/api/ai/suno/stream?taskId=${sunoTask.taskId}&genre=${encodeURIComponent(genre)}`,
            synthData: { tempo: 120 },
            duration: 180,
            createdAt: new Date().toISOString()
          };
          return res.json({ success: true, song: createdSong, provider: "QamuzEngineProxy" });
        }
      } catch (sunoErr: any) {
        console.warn("Kie Suno API submission error, falling back to Qamuz Gemini Engine:", sunoErr?.message || sunoErr);
      }
    }

    // Default Qamuz Gemini Engine Composer
    const ai = getGeminiClient();

    const systemPrompt = `Eres el motor de producción musical de elite para Qamuz AI Studio, impulsado por algoritmos de predicción de éxitos analizando datos de Spotify API y Last.fm.
Tu tarea es componer una canción completa optimizada para enganche musical, estructura de hit global, armonía pegajosa y letras poéticas con ritmo perfecto.
Debes devolver la respuesta strictly en JSON con la siguiente estructura:
{
  "title": "Título sugerido de la canción",
  "artist": "Nombre artístico generado por IA (ej: Qamuz AI, Luna Sol, Vox Neon)",
  "album": "Sencillo Qamuz AI Studio",
  "genre": "Género musical principal",
  "bpm": 120,
  "key": "C Mayor",
  "lyrics": [
    { "time": 0, "text": "[Intro Instrumental - Ritmo y sintetizadores]" },
    { "time": 12, "text": "Primera línea de letra aquí..." },
    { "time": 20, "text": "Segunda línea de letra..." }
  ],
  "fullLyricsText": "Letra completa con etiquetas [Verso 1], [Estribillo], [Puente], [Outro]",
  "coverArtPrompt": "Descripción detallada para la portada del álbum estilo artístico vibrante 1:1 square",
  "audioCharacteristics": {
    "scale": "major",
    "tempo": 120,
    "vibe": "energético, pegajoso",
    "baseFrequency": 440
  }
}`;

    const userPromptText = `Genera una canción completa de música ${genre}, ambiente ${mood}, estilo vocal ${vocalStyle}.
${instrumentalOnly ? "Nota: Es un tema instrumental, enfócate en melodías sin voz." : ""}
${title ? `Título preferido: "${title}"` : ""}
${customLyrics ? `Usa estas letras del usuario como base principales:\n${customLyrics}` : `Genera letras creativas y profundas basadas en esta idea: "${effectivePrompt}"`}
Asegúrate de estructurar letras con marcas de tiempo temporales adecuadas para sincronizar.`;

    let songData: any;

    try {
      const response = await ai.models.generateContent({
        model: "gemini-3.6-flash",
        contents: userPromptText,
        config: {
          systemInstruction: systemPrompt,
          responseMimeType: "application/json",
          temperature: 0.8,
        },
      });

      const jsonText = response.text || "{}";
      songData = JSON.parse(jsonText);
    } catch (err: any) {
      console.error("Gemini song text generation error:", err);
      songData = {
        title: title || (prompt ? prompt.slice(0, 24) : "Ritmo Estelar"),
        artist: "Qamuz AI Studio",
        album: "Sencillos AI",
        genre: genre || "Urban Pop",
        bpm: 124,
        key: "A Menor",
        lyrics: [
          { time: 0, text: "[Intro Synth - Creado en Qamuz]" },
          { time: 8, text: "Siento la energía brillar en el aire" },
          { time: 16, text: "Un ritmo nuevo que no va a pararse" },
          { time: 24, text: "[Estribillo] Qamuz en tu mente, música sin fin" },
          { time: 32, text: "Siente cada pulso de este serafín" }
        ],
        fullLyricsText: customLyrics || `[Verso 1]\nSiento la energía brillar en el aire\nUn ritmo nuevo que no va a pararse\n\n[Estribillo]\nQamuz en tu mente, música sin fin\nSiente cada pulso de este serafín`,
        coverArtPrompt: `Vibrant abstract artistic album cover for ${genre} music track titled ${title || "Estelar"}`,
        audioCharacteristics: { scale: "minor", tempo: 124, vibe: "electro pop" }
      };
    }

function createSVGAlbumCover(title: string, genre: string): string {
  const gradients = [
    ["#1DB954", "#059669", "#0284c7"],
    ["#8b5cf6", "#ec4899", "#f43f5e"],
    ["#f59e0b", "#d97706", "#ef4444"],
    ["#06b6d4", "#3b82f6", "#6366f1"],
    ["#10b981", "#14b8a6", "#06b6d4"]
  ];
  const g = gradients[Math.floor(Math.random() * gradients.length)];
  const cleanTitle = (title || "Hit Qamuz").replace(/["'<>&]/g, '');
  const cleanGenre = (genre || "AI Studio").replace(/["'<>&]/g, '');

  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="800" height="800" viewBox="0 0 800 800">
    <defs>
      <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="${g[0]}" />
        <stop offset="50%" stop-color="${g[1]}" />
        <stop offset="100%" stop-color="${g[2]}" />
      </linearGradient>
      <radialGradient id="glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.3" />
        <stop offset="100%" stop-color="#000000" stop-opacity="0.8" />
      </radialGradient>
    </defs>
    <rect width="800" height="800" fill="url(#bg)" />
    <circle cx="400" cy="400" r="350" fill="url(#glow)" />
    <circle cx="400" cy="400" r="280" fill="none" stroke="#ffffff" stroke-opacity="0.25" stroke-width="2" />
    <circle cx="400" cy="400" r="180" fill="none" stroke="#ffffff" stroke-opacity="0.35" stroke-width="4" />
    <path d="M 280 400 Q 400 250 520 400 T 760 400" fill="none" stroke="#ffffff" stroke-opacity="0.4" stroke-width="6" />
    <text x="400" y="380" font-family="system-ui, sans-serif" font-size="44" font-weight="900" fill="#ffffff" text-anchor="middle" letter-spacing="2">${cleanTitle}</text>
    <text x="400" y="440" font-family="system-ui, sans-serif" font-size="22" font-weight="700" fill="#1DB954" text-anchor="middle" letter-spacing="4">${cleanGenre.toUpperCase()} • QAMUZ AI</text>
  </svg>`;

  return `data:image/svg+xml;utf8,${encodeURIComponent(svg)}`;
}

    // Attempt Cover Image Generation or Fallback
    let coverUrl = "";
    const coverPromptText = `Album cover artwork for song "${songData.title}" (${songData.genre}), ${songData.coverArtPrompt || prompt || "modern neon music aesthetic"}, professional album cover 8k, vibrant colors, trending on spotify`;
    
    try {
      const imgRes = await ai.models.generateImages({
        model: "imagen-3.0-generate-002",
        prompt: coverPromptText,
        config: {
          numberOfImages: 1,
          outputMimeType: "image/jpeg",
          aspectRatio: "1:1"
        }
      });

      if (imgRes.generatedImages?.[0]?.image?.imageBytes) {
        coverUrl = `data:image/jpeg;base64,${imgRes.generatedImages[0].image.imageBytes}`;
      }
    } catch (imgErr) {
      console.warn("Imagen generation fallback to Pollinations AI:", imgErr);
    }

    if (!coverUrl) {
      // Dynamic AI Generated Cover specific to song title, genre & prompt with SVG fallback
      coverUrl = `https://image.pollinations.ai/prompt/${encodeURIComponent(coverPromptText)}?width=800&height=800&nologo=true&seed=${Date.now()}`;
    }

    const lyricsToSing = songData.fullLyricsText || (songData.lyrics || []).map((l: any) => l.text).join(' ') || effectivePrompt;
    const vocalAudioUrl = `/api/ai/tts-song?title=${encodeURIComponent(songData.title || title || 'Qamuz Hit')}&genre=${encodeURIComponent(songData.genre || genre)}&text=${encodeURIComponent(lyricsToSing)}`;

    const createdSong = {
      id: `ai-song-${Date.now()}-${Math.random().toString(36).substring(2, 9)}`,
      title: songData.title || "Canción Qamuz AI",
      artist: songData.artist || "Qamuz AI Lab",
      album: songData.album || "Qamuz AI Studio",
      genre: songData.genre || genre,
      bpm: songData.bpm || 120,
      key: songData.key || "C",
      lyrics: songData.lyrics || [],
      fullLyricsText: songData.fullLyricsText || "",
      coverUrl,
      audioUrl: vocalAudioUrl,
      synthData: songData.audioCharacteristics || { tempo: 120 },
      duration: 180,
      createdAt: new Date().toISOString()
    };

    return res.json({ success: true, song: createdSong });
  } catch (error: any) {
    console.error("Error generating AI song:", error);
    return res.status(500).json({ error: error?.message || "Error al generar la canción con IA" });
  }
});

// API 2: Generate AI Video (Qamuz Visual Engine)
app.post("/api/ai/generate-video", async (req, res) => {
  try {
    const { 
      prompt = "", 
      style = "Cinemático Ultra HD", 
      cameraMotion = "Zoom in y barrido dinámico", 
      aspectRatio = "16:9", 
      songTitle = "",
      videoType = "music-video",
      is30sViralHook = false,
      character = "",
      background = "",
      vibeTags = [],
      videoGenMode = "one-click"
    } = req.body;

    const effectivePrompt = prompt || (songTitle ? `Video musical para la canción "${songTitle}"` : "Video musical cinemático de alto impacto");

    const ai = getGeminiClient();

    const systemPrompt = `Eres un director de cine visual e inteligencia artificial para videoclips en Qamuz Studio.
Tu objetivo es crear una secuencia visual cinemática estructurada para un videoclip musical o vídeo de letras.
${is30sViralHook ? 'IMPORTANTE: Modo Clip Viral de 30 segundos activado. Identifica y enfoca la secuencia en los 30 segundos con el mayor enganche, ritmo trascendente y momento climático de la canción (TikTok / Instagram Reels / YouTube Shorts).' : ''}
${videoType === 'lyrics-video' ? 'Modo Lyrics Video: Diseña un entorno dinámico con tipografía animada y efectos de letras en pantalla.' : ''}

Devuelve STRICTAMENTE un objeto JSON:
{
  "title": "Título del video conceptual",
  "style": "Estilo cinematográfico",
  "cameraMotion": "Movimiento de cámara",
  "sceneDescription": "Descripción paso a paso de la escena",
  "viralHookTimestamp": "00:15 - 00:45 (Clímax rítmico de 30s)",
  "framePrompts": [
    "Descripción escena 1...",
    "Descripción escena 2...",
    "Descripción escena 3..."
  ],
  "colorPalette": ["#111", "#FF007A", "#00F5A0"],
  "visualVibe": "Atmósfera sci-fi, movimiento fluido"
}`;

    let videoData: any;
    try {
      const response = await ai.models.generateContent({
        model: "gemini-3.6-flash",
        contents: `Crea la dirección visual de un video musical (${videoType}) para: "${effectivePrompt}". 
Estilo: ${style}. Cámara: ${cameraMotion}. 
${songTitle ? `Canción vinculada: "${songTitle}"` : ''} 
${character ? `Personaje / Avatar principal: ${character}` : ''} 
${background ? `Fondo / Escenario: ${background}` : ''} 
${vibeTags.length > 0 ? `Atmósfera y energía (Vibe): ${vibeTags.join(', ')}` : ''}
${is30sViralHook ? 'ALGORITMO DE ENGANCHE 30s: Detecta el segmento con mayor trascendencia rítmica para reels/viral clip.' : ''}`,
        config: {
          systemInstruction: systemPrompt,
          responseMimeType: "application/json",
          temperature: 0.85,
        },
      });

      videoData = JSON.parse(response.text || "{}");
    } catch (e) {
      videoData = {
        title: `Video AI: ${prompt.slice(0, 20)}`,
        style: style || "Cinemático Cyberpunk",
        cameraMotion: cameraMotion || "Movimiento órbita 360",
        sceneDescription: prompt,
        framePrompts: [
          `Escena de apertura: ${prompt}`,
          `Evolución del entorno con luces de neón y efecto de movimiento en masa`,
          `Clímax visual con partículas flotantes y ángulo dinámico`
        ],
        colorPalette: ["#000000", "#1DB954", "#9B51E0"]
      };
    }

    // Generate frame stills for visual video preview
    const sceneFrames: string[] = [];
    const samplePrompts = videoData.framePrompts || [prompt];

    const [w, h] = aspectRatio === "9:16" ? [720, 1280] : aspectRatio === "1:1" ? [800, 800] : [1280, 720];

    for (let i = 0; i < Math.min(3, samplePrompts.length); i++) {
      try {
        const framePrompt = `${samplePrompts[i]}, ${style} visual style, cinematic lighting, 8k resolution`;
        // Generate high resolution visual frame
        const frameUrl = `https://image.pollinations.ai/prompt/${encodeURIComponent(framePrompt)}?width=${w}&height=${h}&nologo=true&seed=${Date.now() + i * 137}`;
        sceneFrames.push(frameUrl);
      } catch (err) {
        console.warn(`Frame ${i} generation fallback`);
      }
    }

    if (sceneFrames.length === 0) {
      sceneFrames.push(
        "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?q=80&w=1000&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1508700115892-45ecd05ae2ad?q=80&w=1000&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?q=80&w=1000&auto=format&fit=crop"
      );
    }

    const createdVideo = {
      id: `ai-video-${Date.now()}-${Math.random().toString(36).substring(2, 9)}`,
      title: videoData.title || "Video Musical Qamuz AI",
      prompt,
      style: videoData.style || style,
      cameraMotion: videoData.cameraMotion || cameraMotion,
      thumbnailUrl: sceneFrames[0],
      sceneFrames,
      createdAt: new Date().toISOString(),
      songTitle: songTitle || "Tema Qamuz AI"
    };

    return res.json({ success: true, video: createdVideo });
  } catch (error: any) {
    console.error("Error generating AI video:", error);
    return res.status(500).json({ error: error?.message || "Error al generar el video con IA" });
  }
});

// API 3: Generate AI Image & Album Art (Qamuz Art Studio)
app.post("/api/ai/generate-image", async (req, res) => {
  try {
    const { prompt, style = "Arte de Portada de Álbum", aspectRatio = "1:1", category = "album-cover" } = req.body;

    if (!prompt) {
      return res.status(400).json({ error: "Escribe una descripción para la imagen." });
    }

    const fullPrompt = `${prompt}, ${style} style, ultra high quality, professional artistic visual for music album cover and digital art`;
    
    let imageUrl = "";

    // Calculate dimensions based on aspect ratio
    let width = 800;
    let height = 800;
    if (aspectRatio === "16:9") { width = 1280; height = 720; }
    else if (aspectRatio === "9:16") { width = 720; height = 1280; }
    else if (aspectRatio === "3:4") { width = 768; height = 1024; }
    else if (aspectRatio === "4:3") { width = 1024; height = 768; }

    // Try Gemini Imagen if available, else fast robust Pollinations AI
    try {
      const ai = getGeminiClient();
      const imgRes = await ai.models.generateImages({
        model: "imagen-3.0-generate-002",
        prompt: fullPrompt,
        config: {
          numberOfImages: 1,
          outputMimeType: "image/jpeg",
          aspectRatio: aspectRatio === "16:9" ? "16:9" : aspectRatio === "9:16" ? "9:16" : aspectRatio === "3:4" ? "3:4" : "1:1"
        }
      });

      if (imgRes.generatedImages?.[0]?.image?.imageBytes) {
        imageUrl = `data:image/jpeg;base64,${imgRes.generatedImages[0].image.imageBytes}`;
      }
    } catch (err: any) {
      // Quietly fall back to high quality Pollinations AI image generator without throwing error logs
    }

    if (!imageUrl) {
      imageUrl = `https://image.pollinations.ai/prompt/${encodeURIComponent(fullPrompt)}?width=${width}&height=${height}&nologo=true&seed=${Date.now()}`;
    }

    const createdImage = {
      id: `ai-img-${Date.now()}-${Math.random().toString(36).substring(2, 9)}`,
      title: `Arte: ${prompt.slice(0, 24)}`,
      prompt,
      style,
      category,
      aspectRatio,
      imageUrl,
      createdAt: new Date().toISOString()
    };

    return res.json({ success: true, image: createdImage });
  } catch (error: any) {
    console.error("Error generating AI image:", error);
    return res.status(500).json({ error: error?.message || "Error al generar la imagen con IA" });
  }
});

async function startServer() {
  // Vite middleware for dev
  if (process.env.NODE_ENV !== "production") {
    const vite = await createViteServer({
      server: { middlewareMode: true },
      appType: "spa",
    });
    app.use(vite.middlewares);
  } else {
    const distPath = path.join(process.cwd(), "dist");
    app.use(express.static(distPath));
    app.get("*", (_req, res) => {
      res.sendFile(path.join(distPath, "index.html"));
    });
  }

  app.listen(PORT, "0.0.0.0", () => {
    console.log(`Qamuz App server running on http://0.0.0.0:${PORT}`);
  });
}

startServer();
